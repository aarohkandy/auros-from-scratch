#!/bin/sh
# ═══════════════════════════════════════════════════════════════════
#  ferry-firefox — her Firefox comes across, without its passwords.
#
#  Firefox keeps everything in one profile folder in files Firefox on
#  Linux reads unchanged, so the strategy is not to parse anything: the
#  profile is copied file by file. Bookmarks, history, open tabs,
#  cookies and settings all just work on the other side.
#
#  SAVED PASSWORDS DO NOT COME. Ferry never copies or decrypts saved
#  passwords (docs/FERRY.md, "Passwords"). Firefox keeps them in
#  logins.json, sealed with the key in key4.db; both are left on
#  Windows, together with the older forms of the same thing (key3.db,
#  signons.sqlite, logins-backup.json) and saved payment cards and
#  addresses (autofill-profiles.json, sealed with the same key). The
#  report tells her so in plain words; websites ask once, and Windows
#  still has them while it is on the disk.
#
#  What we also DROP from the copy:
#    - cache2/, startupCache/, thumbnails/ — regenerated, and big;
#    - lock / .parentlock — a stale lock stops Firefox starting;
#    - compatibility.ini — pins the profile to the old binary's path;
#    - installs.ini and the [Install...] part of profiles.ini — they
#      claim the profile for the WINDOWS Firefox, so Linux Firefox would
#      not use it; Ferry writes its own profiles.ini instead (the old one
#      is kept beside it);
#    - crashes/, minidumps/, datareporting/ telemetry.
#
#    ferry-firefox                import every Firefox profile
#    ferry-firefox --dry-run      show what would copy
# ═══════════════════════════════════════════════════════════════════
set -eu
. "$(dirname "$0")/ferry-common.sh"

while [ $# -gt 0 ]; do
    common_opt "$@"
    if [ "${_consumed:-0}" -gt 0 ]; then shift "$_consumed"; continue; fi
    case $1 in
        -h|--help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die "unknown option '$1'" ;;
    esac
done

[ -n "$FERRY_ROOT" ] || die "ferry-firefox needs a mounted Windows volume (--root)"
stage_begin firefox
require_clean_volume "$FERRY_ROOT" "$FERRY_DEV"
resolve_target
select_profile || die "could not identify which Windows profile to import (pass --user NAME)"

_ffsrc=$(path_ci "$_WIN_PROFILE_DIR" "AppData/Roaming/Mozilla/Firefox" 2>/dev/null || true)
if [ -z "$_ffsrc" ]; then
    say "no Firefox profile found for $_WIN_USERNAME"
    note firefox info "Firefox" "no Firefox installation was found in this profile"
    stage_done firefox
    exit 0
fi

_dest="$FERRY_HOME/.mozilla/firefox"

# The names we refuse to copy. ferry-copy matches a folder name at any
# depth (so a folder called cache2 anywhere in the profile is dropped,
# but a bookmark whose title contains "cache" is not) and a file name
# at any depth, both ignoring case: NTFS does, and a profile copied
# about by hand can come back as LOGINS.JSON.
SKIP_COMPONENTS="cache2 startupCache shader-cache thumbnails crashes minidumps datareporting"
SKIP_FILES=".parentlock parent.lock lock compatibility.ini"
# Saved passwords and what they are sealed with. Never copied; the
# test suite fails if any of these appears under the new home.
SECRET_FILES="logins.json logins-backup.json key4.db key3.db signons.sqlite \
signons.txt signons2.txt signons3.txt autofill-profiles.json"

# profiles.ini from Windows names the WINDOWS Firefox install (an
# [InstallXXXX] section keyed on its path), so Linux Firefox would not
# treat any profile in it as its own and would start a new, empty one:
# "my bookmarks are gone". So Ferry writes its own: the profile Windows
# Firefox used is the default, the others are listed, and there is no
# install section, which is what Firefox expects of a profile it has
# not seen before. The old file is kept beside it.
#   prints: NAME <tab> BASENAME <tab> ISDEFAULT   (default first)
ini_profiles() {
    awk '
    function clean(v) { gsub(/[\r\001-\037]/, "", v); return v }
    /^\[/ { sec = clean($0); gsub(/[\[\]]/, "", sec); next }
    { n = index($0, "="); if (!n) next
      k = clean(substr($0, 1, n - 1)); v = clean(substr($0, n + 1))
      if (sec ~ /^Profile[0-9]+$/) {
          if (!(sec in seen)) { seen[sec] = 1; order[++np] = sec }
          P[sec, k] = v
      } else if (sec ~ /^Install/ && k == "Default" && inst == "") inst = v }
    function base(p) { sub(/.*[\/\\]/, "", p); return p }
    END {
        pick = 0
        for (i = 1; i <= np && !pick; i++) if (inst != "" && P[order[i], "Path"] == inst) pick = i
        for (i = 1; i <= np && !pick; i++) if (P[order[i], "Default"] == 1) pick = i
        if (!pick && np) pick = 1
        for (i = 1; i <= np; i++) {
            s = order[i]
            if (P[s, "IsRelative"] == 0) continue      # an absolute Windows path: not on this disk
            printf "%s\t%s\t%d\n", P[s, "Name"], base(P[s, "Path"]), (i == pick)
        }
    }' "$1"
}

# ── Collect the profile directories and copy them, all in one pass.
_profdir=$(path_ci "$_ffsrc" "Profiles" 2>/dev/null || true)
_ini=$(path_ci "$_ffsrc" "profiles.ini" 2>/dev/null || true)

set --
for _x in $SKIP_COMPONENTS; do set -- "$@" --skip-dir "$_x"; done
for _x in $SKIP_FILES $SECRET_FILES; do set -- "$@" --skip-file "$_x"; done

_count=0 _names=""
if [ -n "$_profdir" ]; then
    for _p in "$_profdir"/*; do
        [ -d "$_p" ] || continue
        [ ! -L "$_p" ] || continue          # a link is not a profile
        _pname=$(basename "$_p")
        say "Firefox profile: $_pname"
        set -- "$@" --job "Firefox/$_pname" "$_p" "$_dest/Profiles/$_pname"
        _names="$_names
$_pname"
        _count=$((_count+1))

        # Report what came, and what was left behind on purpose.
        note firefox/profile info "Firefox/$_pname" \
            "bookmarks, history, open tabs and settings brought across"
        if [ -n "$(path_ci "$_p" "logins.json" 2>/dev/null || true)" ] || \
           [ -n "$(path_ci "$_p" "key4.db" 2>/dev/null || true)" ]; then
            note firefox/passwords manual "Firefox saved passwords" \
                "left on Windows on purpose: AurOS never copies saved passwords. Websites ask for each one once."
        fi
    done
fi

_rc=0
if [ "$_count" -gt 0 ]; then
    her_copy "$@" || _rc=$?
fi
case $_rc in
    0|2) : ;;
    4)   stage_fail firefox "out of room"; die "there is no more room on this computer for your Firefox settings" ;;
    *)   stage_fail firefox "ferry-copy exited $_rc"; die "could not copy your Firefox settings (ferry-copy exit $_rc)" ;;
esac

# The profiles.ini that makes Linux Firefox open the copied profile.
if [ "$_count" -gt 0 ]; then
    {
        _i=0 _def=""
        if [ -n "$_ini" ]; then _rows=$(ini_profiles "$_ini"); else _rows=""; fi
        # The profile Windows Firefox used goes first as Profile0 and is the default.
        _ordered=""
        _nl='
'
        _first=$(printf '%s\n' "$_rows" | awk -F'\t' '$3 == 1 { print; exit }')
        [ -n "$_first" ] || _first=$(printf '%s\n' "$_rows" | awk 'NF { print; exit }')
        # A directory the ini did not name (or no ini at all) still comes.
        if [ -z "$_first" ]; then
            _b=$(printf '%s\n' "$_names" | awk 'NF { print; exit }')
            _first=$(printf '%s\t%s\t1' "$_b" "$_b")
        fi
        _emit() {   # NAME BASENAME DEFAULT
            [ -d "$_profdir/$2" ] || return 0
            _nm=$(printf '%s' "$1" | tr -d '\r\n'); [ -n "$_nm" ] || _nm=$2
            printf '[Profile%d]\nName=%s\nIsRelative=1\nPath=Profiles/%s\n' "$_i" "$_nm" "$2"
            [ "$3" = 1 ] && printf 'Default=1\n'
            printf '\n'
            _i=$((_i+1))
        }
        _emit "$(printf '%s' "$_first" | cut -f1)" "$(printf '%s' "$_first" | cut -f2)" 1
        _fb=$(printf '%s' "$_first" | cut -f2)
        printf '%s\n' "$_rows" | while IFS='	' read -r _n _b _d; do
            [ -n "$_b" ] && [ "$_b" != "$_fb" ] || continue
            _emit "$_n" "$_b" 0
        done
        printf '[General]\nStartWithLastProfile=1\nVersion=2\n'
    } > "$FERRY_STATE/plan/profiles.ini.new"
    her_put "$_dest/profiles.ini" --backup .before-windows < "$FERRY_STATE/plan/profiles.ini.new" || \
        warn "could not write profiles.ini for Firefox"
    rm -f "$FERRY_STATE/plan/profiles.ini.new"
fi

if [ "$_count" = 0 ]; then
    note firefox partial "Firefox" \
        "a Firefox folder existed but no profiles could be enumerated"
fi

_written=$(awk -F'\t' -v s=firefox '$2==s && $3=="copy"' "$FERRY_STATE/manifest.tsv" 2>/dev/null | wc -l | tr -d ' ')
say "firefox: $_count profile(s), $_written file(s) copied"
stage_done firefox "$_count profiles"
exit 0
