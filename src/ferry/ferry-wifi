#!/bin/sh
# ═══════════════════════════════════════════════════════════════════
#  ferry-wifi — say which Wi-Fi networks she used on Windows.
#
#  IT NEVER BRINGS A PASSWORD ACROSS. Not a cleartext one, not a
#  decrypted one. Ferry does not copy or decrypt saved passwords, full
#  stop (docs/FERRY.md, "Passwords"). This file used to write each
#  network into NetworkManager with its key, and carried a call-out to
#  decrypt the DPAPI-protected ones offline from the SYSTEM and
#  SECURITY hives. Both are gone, and the test suite proves neither
#  comes back: no key is read from a profile, no helper is run, no
#  keyfile is written.
#
#  The one Wi-Fi network that does come across is the one she was on
#  when she installed: the installer reads it in Windows, with her
#  consent (the "Bring my Wi-Fi across" tick box, owner decision D10),
#  and staging writes it. That is a decision she made in front of a
#  screen that said so. Ferry runs later, on a whole disk of networks
#  she never chose to hand over, so it only lists them:
#
#    secured (WPA2/WPA3)   listed by name; AurOS asks for the password
#                          once, the first time she is near it
#    open                  listed by name; nothing to bring
#    enterprise (802.1X)   listed; she signs in again
#
#  The profile XML is read with a tolerant extractor: its schema is
#  fixed, the tags we want do not nest, and the base system has no XML
#  library. Nothing read from it is used as a file name.
#
#    ferry-wifi                 list the networks into the report
#    ferry-wifi --dry-run       the same (nothing is ever written)
#  (--to DIR and --no-reload are accepted and ignored: older callers.)
# ═══════════════════════════════════════════════════════════════════
set -eu
. "$(dirname "$0")/ferry-common.sh"

while [ $# -gt 0 ]; do
    common_opt "$@"
    if [ "${_consumed:-0}" -gt 0 ]; then shift "$_consumed"; continue; fi
    case $1 in
        --to)        : "${2:?--to needs a dir}"; shift 2 ;;
        --no-reload) shift ;;
        -h|--help)   sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die "unknown option '$1'" ;;
    esac
done

[ -n "$FERRY_ROOT" ] || die "ferry-wifi needs a mounted Windows volume (--root)"
stage_begin wifi
require_clean_volume "$FERRY_ROOT" "$FERRY_DEV"

WLAN=$(path_ci "$FERRY_ROOT" "ProgramData/Microsoft/Wlansvc/Profiles/Interfaces" 2>/dev/null || true)
if [ -z "$WLAN" ]; then
    say "no saved Wi-Fi networks on this PC"
    stage_done wifi "0 networks"
    exit 0
fi

# One XML element's text, namespace-agnostic. Never <keyMaterial>:
# this stage has no reason to look at a key, so it cannot.
xml_field() {
    case "$2" in keyMaterial|sharedKey|protected) return 1 ;; esac
    awk -v tag="$2" '
    BEGIN { RS=">"; FS="<"; hit=0 }
    {
        if (hit) { v = $1; gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", v); print v; exit }
        t = $2
        sub(/[ \t\r\n].*/, "", t); sub(/\/.*/, "", t)
        sub(/^[^:]*:/, "", t)
        if (t == tag) hit = 1
    }' "$1"
}

# <hex>486F6D65</hex> -> "Home", for SSIDs whose <name> is missing.
# No strtonum: the image's awk is mawk, which does not have it.
hex_to_ascii() {
    printf '%s' "$1" | awk '
    { s = tolower($0); out = ""; h = "0123456789abcdef"
      for (i = 1; i + 1 <= length(s); i += 2) {
          a = index(h, substr(s, i, 1)); b = index(h, substr(s, i + 1, 1))
          if (!a || !b) break
          c = (a - 1) * 16 + (b - 1)
          if (c >= 32 && c != 127) out = out sprintf("%c", c)
      }
      printf "%s", out }'
}

kind_of() {
    case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
        open)                                    printf 'open' ;;
        wpapsk|wpa2psk|wpa-psk|wpa3sae|sae|owe)  printf 'secured' ;;
        wpa|wpa2|wpa3|wpa3ent|wpa3enterprise*)   printf 'enterprise' ;;
        *)                                       printf 'other' ;;
    esac
}

TOTAL=$(find "$WLAN" -name '*.xml' 2>/dev/null | wc -l | tr -d ' ')
say "found $TOTAL saved Wi-Fi network(s); listing them (passwords stay on Windows)"

_n=0
find "$WLAN" -name '*.xml' 2>/dev/null | sort | while read -r _xml; do
    _n=$((_n+1))
    _ssid=$(xml_field "$_xml" name | head -1)
    if [ -z "$_ssid" ]; then
        _hex=$(xml_field "$_xml" hex | head -1)
        [ -n "$_hex" ] && _ssid=$(hex_to_ascii "$_hex")
    fi
    [ -n "$_ssid" ] || continue
    progress wifi "$_n" "$TOTAL" "$_ssid"
    case "$(kind_of "$(xml_field "$_xml" authentication | head -1)")" in
        secured)
            note wifi/network manual "$_ssid" \
                "Wi-Fi network you used on Windows. Its password stays on Windows; AurOS asks for it once, the first time you are near it." ;;
        open)
            note wifi/open info "$_ssid" \
                "open Wi-Fi network you used on Windows; there is nothing to bring across" ;;
        enterprise)
            note wifi/enterprise manual "$_ssid" \
                "work or school Wi-Fi network; sign in to it again the first time you are near it" ;;
        *)
            note wifi/network manual "$_ssid" \
                "Wi-Fi network you used on Windows; AurOS asks how to join it the first time you are near it" ;;
    esac
done

stage_done wifi "$TOTAL networks listed"
exit 0
