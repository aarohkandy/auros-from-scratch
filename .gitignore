# Build artifacts — everything here is reproducible from source.
/work/
/out/
/sources/
/sysroot/
*.o
*.a
*.img
*.iso
*.tar.*
*.log

# Compiled helpers — rebuilt by the Makefile / forge in-chroot.
/src/ferry/build/

# Agent worktrees and session scratch.
/.claude/

# Generated by wayland-scanner at build time.
/build/gen/

# Python's own cache. tools/efivarstore.py is imported by the loader
# test, so running it leaves a .pyc behind -- one of which was
# committed, and then turned up in every diff that touched the reader.
__pycache__/
*.pyc

# Playwright screenshots from checking the website; scratch, not source.
website-shots/
