def efivar(efivars, name, guid):
    """The variable's data, or None if it does not exist. A variable
    that exists and cannot be read raises: that is not an empty dbx."""
    try:
        with open(os.path.join(efivars, "%s-%s" % (name, guid)), "rb") as f:
            d = f.read()
    except FileNotFoundError:
        return None
    return d[4:]          # efivarfs: four bytes of attributes first


def sig_lists(data):
    """(x509 certs DER, sha256 hashes, x509-tbs sha256 hashes) from
    EFI_SIGNATURE_LISTs."""
    certs, hashes_, tbs = [], set(), set()
    o = 0
    while data and o + 28 <= len(data):
        typ = data[o:o + 16]
        lsize, hsize, ssize = struct.unpack_from("<III", data, o + 16)
        if lsize < 28 or ssize < 16 or o + lsize > len(data):
            break
        p = o + 28 + hsize
        while p + ssize <= o + lsize:
            body = data[p + 16:p + ssize]
            if typ == CERT_X509:
                certs.append(body)
            elif typ == CERT_SHA256:
                hashes_.add(body)
            elif typ == CERT_X509_SHA256:
                tbs.add(body[:32])
            p += ssize
        o += lsize
    return certs, hashes_, tbs


def certs_of(ders):
    return [c for c in (load_cert(d) for d in ders) if c]


def firmware(efivars):
    """This machine's Secure Boot state, or None if it cannot be read.
    A machine whose variables cannot be read is not a machine whose
    Secure Boot is off: it is one we know nothing about, and a shim
    nobody checked is not installed on it."""
    try:
        sb = efivar(efivars, "SecureBoot", EFI_GLOBAL)
        db = efivar(efivars, "db", EFI_IMAGE_SECURITY)
        dbx = efivar(efivars, "dbx", EFI_IMAGE_SECURITY)
        lvl = efivar(efivars, "SbatLevelRT", SHIM_LOCK)
    except OSError:
        return None
    if sb is None or db is None:
        return None
    dbc, dbh, _ = sig_lists(db)
    xc, xh, xt = sig_lists(dbx or b"")
    return {
        "secureboot": sb[:1] == b"\x01",
        "db": certs_of(dbc), "db_hashes": dbh,
        "dbx": certs_of(xc), "dbx_hashes": xh, "dbx_tbs": xt,
        "sbat": sbat_csv((lvl or b"").decode("latin-1")),
    }


class CannotLook(Exception):
    """Something this computer starts could not be examined."""


def restore_kernels(args):
    """name -> bytes of every \\EFI\\AurOS\\staging.efi on any EFI
    partition that is not AurOS's own -- the Put Windows back kernel the
    installer left on Windows' partition. Mounted READ-ONLY (vfat,
    nodev, nosuid, noexec), under a timeout, and always unmounted, as
    answer.sh looks for it; AurOS never writes there.

    FAILS CLOSED. If the partitions cannot be listed, or one of them
    cannot be mounted, the restore kernel is not "absent": it is unknown,
    and a shim that might refuse it is not installed. Every copy found
    is judged, not the first: grub's `search` may pick any of them.
    --esp-roots (tests) names directories instead of mounting."""
    if "esp-roots" in args:
        out = {}
        for d in args["esp-roots"].split(":"):
            p = os.path.join(d, "EFI", "AurOS", "staging.efi")
            if d and os.path.isfile(p):
                out["the Put Windows back kernel in %s" % d] = read(p)
        return out
    try:
        # --esp-scan DEV (tests): the same scan, of one disk only.
        # PARTTYPE is NOT taken from lsblk: it comes from udev's
        # database, and where that is missing every partition's type is
        # empty -- no EFI partitions at all, which read as "no restore
        # kernel" and let a shim through unchecked. Each partition is
        # probed directly instead (blkid -p reads the partition table).
        r = subprocess.run(["lsblk", "-rnpo", "PATH,TYPE,MOUNTPOINT"] +
                           ([args["esp-scan"]] if "esp-scan" in args else []),
                           capture_output=True, text=True, timeout=30)
    except Exception as e:
        raise CannotLook("could not list this computer's partitions (%s)" % e)
    if r.returncode != 0:
        raise CannotLook("could not list this computer's partitions")
    own = None
    try:
        own = os.stat("/boot/efi").st_dev
    except OSError:
        pass
    out, mounted = {}, []
    try:
        for line in r.stdout.splitlines():
            p = line.split(" ", 2)
            if len(p) < 2 or p[1] != "part":
                continue
            b = subprocess.run(["blkid", "-p", "-o", "value", "-s", "PART_ENTRY_TYPE", p[0]],
                               capture_output=True, text=True, timeout=30)
            if b.returncode not in (0, 2):        # 2: nothing to report
                raise CannotLook("could not read the type of %s" % p[0])
            if b.stdout.strip().lower() != ESP_TYPE:
                continue
            mp = p[2].replace("\\x20", " ") if len(p) > 2 and p[2] else None
            if mp:
                try:
                    if os.stat(mp).st_dev == own:
                        continue          # AurOS's own: that is /boot/efi
                except OSError:
                    pass
                where = mp
            else:
                m = tempfile.mkdtemp(prefix="auros-esp.")
                rc = subprocess.run(["mount", "-t", "vfat", "-o", "ro,nodev,nosuid,noexec",
                                     p[0], m], capture_output=True, timeout=60).returncode
                if rc != 0:
                    os.rmdir(m)
                    raise CannotLook("could not look inside %s" % p[0])
                mounted.append(m)
                where = m
            f = os.path.join(where, "EFI", "AurOS", "staging.efi")
            if os.path.isfile(f):
                out["the Put Windows back kernel on %s" % p[0]] = read(f)
    finally:
        for m in mounted:
            try:
                subprocess.run(["umount", m], capture_output=True, timeout=60)
                os.rmdir(m)
            except Exception:
                pass
    return out


# ═══════════════════════════════════════════════════════════════════
#  sync
# ═══════════════════════════════════════════════════════════════════
def read(path):
    with open(path, "rb") as f:
        return f.read()


def judge_shim(shim_data, fw):
    """None if this firmware starts SHIM_DATA, else why not."""
    w = judge_image(shim_data, fw["db"], fw["dbx"], fw["dbx_hashes"], fw["dbx_tbs"],
                    fw["db_hashes"])
    if w:
        return "the firmware would refuse the shim: " + w
    try:
        r = revoked_by(PE(shim_data).sbat(), fw["sbat"])
    except Exception:
        return "the shim cannot be read"
    if r:
        return "this firmware's SBAT level revokes the shim (%s %d < %d)" % r[0]
    return None


def judge_loads(shim_data, gdata, fw, loads):
    """None if SHIM_DATA starts GRUB and every image in LOADS (name ->
    bytes: the kernels, the restore kernel, MokManager): each must chain
    to the shim's vendor certificate (or db), be revoked by neither its
    vendor dbx nor the firmware's dbx, and pass SBAT at the shim's own
    latest level merged with NVRAM's -- which the shim never lowers."""
    try:
        shim = PE(shim_data)
    except Exception:
        return "the shim cannot be read"
    vend, (vx_c, vx_h, vx_t) = shim_vendor(shim)
    anchors = certs_of(vend) + fw["db"]
    deny = fw["dbx"] + certs_of(vx_c)
    deny_h = fw["dbx_hashes"] | vx_h
    deny_t = fw["dbx_tbs"] | vx_t
    _, latest = shim_levels(shim)
    if not latest:
        return "the shim has no SBAT level this program can read"
    level = dict(fw["sbat"])
    for k, v in latest.items():
        level[k] = max(level.get(k, 0), v)
    for name, data in [("grub", gdata)] + sorted(loads.items()):
        w = judge_image(data, anchors, deny, deny_h, deny_t, fw["db_hashes"])
        if w:
            return "it would refuse %s: %s" % (name, w)
        try:
            sb = PE(data).sbat()
        except Exception:
            sb = {}
        if name == "grub" and not sb:
            return "the grub has no .sbat section, and shim refuses that"
        r = revoked_by(sb, level)
        if r:
            return "its SBAT level revokes %s (%s %d < %d)" % ((name,) + r[0])
    return None


def sha(path):
    try:
        return hashlib.sha256(read(path)).hexdigest()
    except OSError:
        return None


def record(root, **kv):
    """Write the state `status` shows. The last update is kept across
    the runs that find nothing to do -- dpkg runs this several times per
    upgrade, and the one that installed something is the one a person
    helping on the phone needs to see: when, and what it checked."""
    kv["when"] = time.strftime("%Y-%m-%dT%H:%M:%S")
    if kv.get("result", "").startswith("updated"):
        kv["last_update"] = kv["when"]
    else:
        try:
            with open(os.path.join(root, STATE)) as f:
                for line in f:
                    k, _, v = line.rstrip("\n").partition("=")
                    if k in ("last_update", "judged") and k not in kv:
                        kv[k] = v
        except OSError:
            pass
    body = "".join("%s=%s\n" % (k, str(v).replace("\n", " ")) for k, v in kv.items())
    try:
        write_atomic(os.path.join(root, STATE), body.encode())
    except OSError:
        pass


def shim_candidates(root):
    """Ubuntu's own choice first: if its postinst pointed the
    alternative at .previous, a kernel installed here is signed with a
    key the newer shim revokes, and only .previous is offered."""
    alt = os.path.join(root, SHIM_ALTERNATIVE)
    target = alt
    try:
        for _ in range(2):
            if not os.path.islink(target):
                break
            t2 = os.readlink(target)
            target = os.path.join(root, t2.lstrip("/")) if t2.startswith("/") else \
                os.path.join(os.path.dirname(target), t2)
        if target.endswith(".previous"):
            return [os.path.join(root, SHIM_PREVIOUS)]
    except OSError:
        pass
    return [os.path.join(root, c) for c in SHIM_LATEST]


def what_it_loads(root, args):
    """name -> bytes of every image the shim will be asked to start
    besides grub: each kernel the menu offers (the newest, the one it
    falls back to, and the one running), MokManager, and every restore
    kernel. Raises CannotLook if a restore kernel cannot be examined."""
    out = {}
    ks = kernels(root)
    for v in ks[:2] + [os.uname().release]:
        p = os.path.join(root, "boot", "vmlinuz-" + v)
        if v in ks and os.path.isfile(p):
            out["kernel " + v] = read(p)
    mm = os.path.join(root, MOKMGR)
    if os.path.isfile(mm):
        out["MokManager"] = read(mm)
    out.update(restore_kernels(args))
    return out


def plan_for(root, esp, aur, shim, grub, shim_first=False):
    """(every copy, the ones whose target differs). Every destination
    in every directory: a sync a power cut stopped after \\EFI\\AurOS
    must not leave \\EFI\\BOOT behind for good. Grub (and the helpers)
    everywhere before the shims, unless SHIM_FIRST: see cmd_sync."""
    dirs = [(aur, "shimx64.efi")]
    boot = os.path.join(esp, "EFI", "BOOT")
    if os.path.isfile(os.path.join(boot, "BOOTX64.EFI")):
        dirs.append((boot, "BOOTX64.EFI"))
    rest, shims = [], []
    mm = os.path.join(root, MOKMGR)
    fb = os.path.join(root, FALLBACK)
    for d, shimname in dirs:
        rest.append((grub, os.path.join(d, "grubx64.efi")))
        if os.path.isfile(mm):
            rest.append((mm, os.path.join(d, "mmx64.efi")))
        if d == boot and os.path.isfile(fb):
            rest.append((fb, os.path.join(d, "fbx64.efi")))
        shims.append((shim, os.path.join(d, shimname)))
    plan = shims + rest if shim_first else rest + shims
    return plan, [(s, t) for s, t in plan if sha(s) != sha(t)]


def cmd_sync(args, dry=False):
    root = args.get("root", "/")
    try:
        return sync(args, root, dry)
    except Exception as e:
        # Never a traceback nobody reads: the wrapper and the apt hook
        # throw output away. What happened goes where `status` looks.
        if not dry:
            record(root, result="failed", reason="%s: %s" % (e.__class__.__name__, e))
        print("bootchain: failed: %s: %s" % (e.__class__.__name__, e), file=sys.stderr)
        return 4


def sync(args, root, dry):
    esp = args.get("esp", os.path.join(root, "boot/efi"))
    efivars = args.get("efivars", "/sys/firmware/efi/efivars")
    aur = os.path.join(esp, "EFI", "AurOS")

    # NOT AN INSTALLED AUROS: forge's chroot, a container, an ESP that
    # is not mounted. grub-install is diverted to this, so dpkg calls it
    # while the image is being built; there is nothing to sync and that
    # is not a failure.
    if not os.path.isfile(os.path.join(aur, "shimx64.efi")):
        print("bootchain: no AurOS boot partition at %s; nothing to do" % esp)
        return 0
    if root == "/" and "esp" not in args and not os.path.ismount(esp):
        print("bootchain: %s is not mounted; nothing to do" % esp)
        return 0

    # Leftovers of a write a power cut stopped. They are ours by name.
    # Not in `status`, which must change nothing and may run beside a sync.
    if not dry:
        for d in (aur, os.path.join(esp, "EFI", "BOOT")):
            for t in glob.glob(os.path.join(d, ".bootchain.*")):
                try:
                    os.unlink(t)
                except OSError:
                    pass

    grub = os.path.join(root, GRUB_CANDIDATE)
    if not os.path.isfile(grub):
        print("bootchain: no signed grub installed; nothing to do")
        return 0
    cur_shim = os.path.join(aur, "shimx64.efi")
    cur_grub = os.path.join(aur, "grubx64.efi")

    fw = firmware(efivars)
    if fw is None:
        reason = "this computer's Secure Boot variables cannot be read"
        print("bootchain: keeping the boot chain this computer has: " + reason)
        if not dry:
            record(root, result="refused", reason=reason, shim=sha(cur_shim), grub=sha(cur_grub))
        return 3
    # Does this firmware still start what is installed? Cheap (no other
    # partitions are looked at), and the line someone helping on the
    # phone needs first. Not a reason to refuse anything.
    today = judge_shim(read(cur_shim), fw)

    # Nothing to change: no further checks, no looking at other
    # partitions. This runs after every dpkg invocation.
    first = next((p for p in shim_candidates(root) if os.path.isfile(p)), None)
    if first and not plan_for(root, esp, aur, first, grub)[1]:
        print("bootchain: boot chain is current (%s)" % os.path.basename(first))
        if not dry:
            record(root, result="current", shim=sha(cur_shim), grub=sha(cur_grub),
                   installed_ok="no: " + today if today else "yes")
        return 0

    try:
        loads = what_it_loads(root, args)
    except CannotLook as e:
        reason = str(e)
        print("bootchain: keeping the boot chain this computer has: " + reason)
        if not dry:
            record(root, result="refused", reason=reason, shim=sha(cur_shim), grub=sha(cur_grub),
                   installed_ok="no: " + today if today else "yes")
        return 3

    gdata = read(grub)
    cur_sdata, cur_gdata = read(cur_shim), read(cur_grub)
    # THE TWO HALF-WAY STATES. A power cut between the two writes leaves
    # one of: (installed shim, new grub) or (new shim, installed grub).
    # Whichever starts decides the order; if neither does, there is no
    # safe order and nothing is written.
    old_shim_new_grub = judge_loads(cur_sdata, gdata, fw, loads)

    chosen, shim_first, why = None, False, []
    for p in shim_candidates(root):
        if not os.path.isfile(p):
            continue
        sdata = read(p)
        w = judge_shim(sdata, fw) or judge_loads(sdata, gdata, fw, loads)
        if w is None:
            if old_shim_new_grub is None:
                chosen = p
                break
            # grub first would leave a grub the old shim refuses;
            # shim first must leave a new shim that starts the old grub
            if judge_loads(sdata, cur_gdata, fw, loads) is None:
                chosen, shim_first = p, True
                break
            w = "no order of the two writes is safe: the old shim refuses the new grub (%s) " \
                "and the new shim refuses the old grub" % old_shim_new_grub
        why.append("%s: %s" % (os.path.basename(p), w))

    # A NEW GRUB ALONE. When no new shim will do (a 2011-only PC once
    # Canonical's shims are 2023-only), the grub must still move: a grub
    # that an SBAT update revokes later is a computer that stops
    # starting AurOS, and the shim it has may well start a newer grub.
    grub_only = chosen is None and old_shim_new_grub is None and today is None
    if chosen is None and not grub_only:
        reason = "; ".join(why) or "no signed shim installed"
        if old_shim_new_grub:
            reason += "; and the shim this computer has would refuse the new grub: " + old_shim_new_grub
        print("bootchain: keeping the boot chain this computer has: " + reason)
        if not dry:
            record(root, result="refused", reason=reason,
                   installed_ok="no: " + today if today else "yes",
                   shim=sha(cur_shim), grub=sha(cur_grub))
        return 3

    if grub_only:
        plan, todo = plan_for(root, esp, aur, cur_shim, grub)
        todo = [(s, t) for s, t in todo if os.path.basename(t) != os.path.basename(cur_shim)
                and os.path.basename(t) != "BOOTX64.EFI"]
    else:
        plan, todo = plan_for(root, esp, aur, chosen, grub, shim_first)
    if not todo:
        print("bootchain: boot chain is current")
        if not dry:
            record(root, result="current", shim=sha(cur_shim), grub=sha(cur_grub),
                   installed_ok="no: " + today if today else "yes")
        return 0
    what = "grub only (%s)" % "; ".join(why) if grub_only else \
        "%s + %s" % (os.path.basename(chosen), os.path.basename(grub))
    if dry:
        print("bootchain: would install " + what)
        return 0

    fail_after = os.environ.get("AUROS_BOOTCHAIN_FAIL_AFTER")   # tests only
    try:
        for s, t in todo:
            write_atomic(t, read(s))
            if fail_after and os.path.basename(t) == fail_after:
                die("stopped after %s (AUROS_BOOTCHAIN_FAIL_AFTER)" % t, 9)
    except OSError as e:
        # Whatever was written is a complete file (write_atomic), and
        # the order was chosen so that what is there still starts.
        record(root, result="failed", reason="writing the EFI partition: %s" % e,
               shim=sha(cur_shim), grub=sha(cur_grub))
        print("bootchain: could not finish writing the EFI partition: %s" % e, file=sys.stderr)
        return 4
    print("bootchain: installed " + what)
    record(root, result="updated-grub-only" if grub_only else "updated",
           shim=sha(cur_shim if grub_only else chosen), grub=sha(grub), installed_ok="yes",
           judged="; ".join(["grub"] + sorted(loads)))
    return 0


def cmd_status(args):
    root = args.get("root", "/")
    try:
        with open(os.path.join(root, STATE)) as f:
            sys.stdout.write(f.read())
    except OSError:
        print("result=never-run")
    return cmd_sync(args, dry=True)


USAGE = ("usage: bootchain menu|sync|status [--root DIR] [--esp DIR] [--efivars DIR]\n"
         "                 [--esp-roots DIR:DIR] [--esp-scan DEV] [--root-uuid UUID] [--running KVER]")


def main(argv):
    if len(argv) < 2 or argv[1] not in ("menu", "sync", "status"):
        print(USAGE, file=sys.stderr)
        return 2
    args = {}
    a = argv[2:]
    while a:
        k = a.pop(0)
        if not k.startswith("--") or not a:
            die("bad argument: %s" % k, 2)
        args[k[2:]] = a.pop(0)
    return {"menu": cmd_menu, "sync": cmd_sync, "status": cmd_status}[argv[1]](args)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
