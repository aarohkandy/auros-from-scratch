def natural_key(s):
    return [int(t) if t.isdigit() else t for t in re.split(r"(\d+)", s)]


def kernels(root):
    """Kernel versions with BOTH a vmlinuz and an initrd, newest first.
    A kernel without its initrd is half installed (dpkg runs the hook
    between the two) and a menu entry for it boots into a panic."""
    boot = os.path.join(root, "boot")
    out = []
    for n in os.listdir(boot) if os.path.isdir(boot) else []:
        if not n.startswith("vmlinuz-"):
            continue
        v = n[len("vmlinuz-"):]
        if v.endswith((".bak", ".old", ".dpkg-tmp", ".dpkg-new", ".efi.signed")):
            continue
        if os.path.isfile(os.path.join(boot, "initrd.img-" + v)):
            out.append(v)
    return sorted(out, key=natural_key, reverse=True)


def root_uuid(root):
    """The UUID grub must search for and the kernel must mount: the one
    /etc/fstab names for /. build/mkimage writes that line. If somebody
    has since edited fstab into another shape, the UUID yesterday's
    menu booted is the next best answer -- failing here fails every
    kernel postinst, and leaves apt half-configured on a machine nobody
    is watching."""
    try:
        with open(os.path.join(root, "etc/fstab")) as f:
            for line in f:
                p = line.split()
                if len(p) >= 2 and p[1] == "/" and p[0].startswith("UUID="):
                    return p[0][5:]
    except OSError:
        pass
    try:
        with open(os.path.join(root, GRUBCFG)) as f:
            m = re.search(r"--fs-uuid --set=root ([0-9A-Fa-f-]{8,64})", f.read())
            if m:
                return m.group(1)
    except OSError:
        pass
    return None


PREVIOUS = """
# THE KERNEL TO FALL BACK TO -- the one running when this menu was
# written, or else the one before the newest -- started by grub on its
# own if the newest cannot be (a signature this shim refuses, a
# truncated file). Written by auros-bootchain; there is one only when
# two kernels are installed.
menuentry 'AurOS (previous kernel, {v})' --class auros --id auros-previous {{
    linux  /boot/vmlinuz-{v} root=UUID={u} ro quiet splash console=tty0 console=ttyS0,115200n8 init_on_alloc=1 slab_nomerge randomize_kstack_offset=on vsyscall=none debugfs=off panic=10 fsck.repair=yes
    initrd /boot/initrd.img-{v}
}}
"""


def fallback_index(cfg):
    """grub's `fallback` takes an entry NUMBER. Ubuntu's grub 2.12 reads
    it with grub_strtoul and unsets it on anything else
    (normal/menu.c, get_and_remove_first_entry_number), so
    `set fallback=auros-previous` -- what this file used to write --
    was silently nothing, and a kernel that would not start was started
    again at every timeout, forever. Found by tools/bootupdatetest.sh
    boot 3 and by review. The number is counted here from the menu as
    written, and refused if anything conditional comes before it,
    because then the number would depend on the machine."""
    n, depth = 0, 0
    for line in cfg.splitlines():
        if line.startswith(("if ", "if\t")):
            depth += 1
        elif line.startswith("fi"):
            depth -= 1
        elif line.startswith(("menuentry ", "submenu ")):
            if "--id auros-previous" in line:
                return n
            if depth:
                raise ValueError("a conditional menu entry comes before auros-previous")
            n += 1
    raise ValueError("no auros-previous entry")


def render_menu(root, uuid=None, running=None):
    with open(os.path.join(root, TEMPLATE)) as f:
        t = f.read()
    ks = kernels(root)
    if not ks:
        raise ValueError("no kernel with an initrd in /boot")
    uuid = uuid or root_uuid(root)
    if not uuid or not re.fullmatch(r"[0-9A-Fa-f-]{8,64}", uuid):
        raise ValueError("cannot tell which filesystem is / (no UUID= line for / in /etc/fstab)")
    theme = ""
    if os.path.isfile(os.path.join(root, THEMECFG)):
        theme = "source /" + THEMECFG
    if running is None:
        running = os.uname().release
    prev = ""
    if len(ks) > 1:
        # The kernel this machine is running has been seen to work; the
        # one before the newest has only been seen to install.
        back = running if running in ks[1:] else ks[1]
        prev = PREVIOUS.format(v=back, u=uuid)
    out = (t.replace("@ROOT_UUID@", uuid).replace("@KVER@", ks[0])
            .replace("@THEME@", theme).replace("@PREVIOUS@", prev))
    if prev:
        out = out.replace("@FALLBACK@", "set fallback=%d\n" % fallback_index(
            out.replace("@FALLBACK@", "")))
    else:
        out = out.replace("@FALLBACK@", "")
    left = re.findall(r"@[A-Z_]+@", out)
    if left:
        raise ValueError("template has placeholders nothing fills: " + " ".join(sorted(set(left))))
    # The two lines everything else depends on. A template edited into
    # a shape that lost either is refused here rather than at a start.
    for must in ("--id auros {", "--id put-windows-back-yes"):
        if must not in out:
            raise ValueError("template lost '%s'" % must)
    return out, ks


def cmd_menu(args):
    root = args.get("root", "/")
    try:
        out, ks = render_menu(root, args.get("root-uuid"), args.get("running"))
    except (OSError, ValueError) as e:
        # The old grub.cfg stays. A machine with yesterday's menu starts;
        # a machine with no menu does not.
        die("grub.cfg not written: %s" % e)
    path = os.path.join(root, GRUBCFG)
    write_atomic(path, out.encode())
    print("bootchain: grub.cfg: AurOS %s%s" % (
        ks[0], (", %d kernels" % len(ks)) if len(ks) > 1 else ""))
    return 0


# ═══════════════════════════════════════════════════════════════════
#  PE / SBAT
# ═══════════════════════════════════════════════════════════════════
class PE:
    def __init__(self, data):
        self.data = data
        if len(data) < 0x40 or data[:2] != b"MZ":
            raise ValueError("not a PE file")
        pe = struct.unpack_from("<I", data, 0x3C)[0]
        if data[pe:pe + 4] != b"PE\0\0":
            raise ValueError("no PE signature")
        nsec, = struct.unpack_from("<H", data, pe + 6)
        symtab, nsym = struct.unpack_from("<II", data, pe + 12)
        optsz, = struct.unpack_from("<H", data, pe + 20)
        opt = pe + 24
        magic, = struct.unpack_from("<H", data, opt)
        if magic == 0x20B:
            dd = opt + 112
        elif magic == 0x10B:
            dd = opt + 96
        else:
            raise ValueError("unknown optional header")
        self.size_of_headers, = struct.unpack_from("<I", data, opt + 60)
        self.cksum_off = opt + 64
        self.certdir_off = dd + 4 * 8
        self.cert_off, self.cert_size = struct.unpack_from("<II", data, self.certdir_off)
        self.sections = {}
        self.raw = []                     # (file offset, size) of each section
        sh = opt + optsz
        strtab = symtab + 18 * nsym
        for i in range(nsec):
            o = sh + 40 * i
            name = data[o:o + 8].rstrip(b"\0").decode("latin-1")
            # A name longer than eight characters is "/N": an offset into
            # the COFF string table. shim's .sbatlevel and .vendor_cert
            # are both stored that way, which is how this parser once
            # found neither and judged every grub against no level at all.
            if name.startswith("/") and name[1:].isdigit() and symtab:
                s = strtab + int(name[1:])
                name = data[s:data.index(b"\0", s)].decode("latin-1")
            vsize, vaddr, rsize, roff = struct.unpack_from("<IIII", data, o + 8)
            self.sections[name] = data[roff:roff + (min(vsize, rsize) if vsize else rsize)]
            if rsize:
                self.raw.append((roff, rsize))

    def authenticode_sha256(self):
        """The digest a signature signs and dbx lists, computed over the
        file in order with the checksum, the certificate directory entry
        and the certificate table left out. edk2_sha256() is the
        firmware's own walk; judge_image requires the two to agree, so
        an image with gaps or trailing data, where they differ, is
        refused rather than judged by a hash the firmware does not use.
        tools/bootchaintest.sh checks this one against osslsigncode."""
        d = self.data
        h = hashlib.sha256()
        h.update(d[:self.cksum_off])
        h.update(d[self.cksum_off + 4:self.certdir_off])
        if self.cert_off:
            h.update(d[self.certdir_off + 8:self.cert_off])
            h.update(d[self.cert_off + self.cert_size:])
        else:
            h.update(d[self.certdir_off + 8:])
        return h.digest()

    def edk2_sha256(self):
        """DxeImageVerificationLib's HashPeImage: the headers, then each
        section's raw data in file order, then what follows the last
        section up to the certificate table."""
        d = self.data
        h = hashlib.sha256()
        h.update(d[:self.cksum_off])
        h.update(d[self.cksum_off + 4:self.certdir_off])
        h.update(d[self.certdir_off + 8:self.size_of_headers])
        done = self.size_of_headers
        for off, size in sorted(self.raw):
            h.update(d[off:off + size])
            done += size
        extra = len(d) - (self.cert_size + done)
        if extra > 0:
            h.update(d[done:done + extra])
        return h.digest()

    def signatures(self):
        """Each WIN_CERTIFICATE PKCS#7 blob (a dual-signed shim has two),
        or None if the table is not one firmware would walk: EDK2 refuses
        the whole image unless the entries, each padded to eight bytes,
        end exactly where the table does."""
        out = []
        o, end = self.cert_off, self.cert_off + self.cert_size
        if not o:
            return out
        if end != len(self.data):
            return None                   # shim: nothing after the table
        while end - o > 8:
            ln, rev, typ = struct.unpack_from("<IHH", self.data, o)
            if ln <= 8 or ln > end - o:
                break
            if typ == 2:
                out.append(self.data[o + 8:o + ln])
            o += ln + ((8 - ln % 8) % 8)
        if o != end:
            return None                   # EDK2: OffSet != SecDataDirEnd
        return out

    def sbat(self):
        return sbat_csv(self.sections.get(".sbat", b"").decode("latin-1"))


def sbat_csv(text):
    """name -> generation, from .sbat or an SbatLevel string. The first
    line of a level is 'sbat,1,<date>' and of a binary 'sbat,1,...';
    neither revokes anything and both are skipped."""
    out = {}
    for line in text.replace("\0", "\n").splitlines():
        p = line.strip().split(",")
        if len(p) < 2 or p[0] in ("", "sbat"):
            continue
        try:
            out[p[0]] = max(out.get(p[0], 0), int(p[1]))
        except ValueError:
            continue
    return out


def shim_levels(pe):
    """(previous, latest) from shim's .sbatlevel: u32 version, then two
    u32 offsets counted from just after the version, each to a
    NUL-terminated level string."""
    s = pe.sections.get(".sbatlevel")
    if not s or len(s) < 12:
        return {}, {}
    _, op, ol = struct.unpack_from("<III", s, 0)

    def at(off):
        b = s[4 + off:]
        return b.split(b"\0", 1)[0].decode("latin-1")
    return sbat_csv(at(op)), sbat_csv(at(ol))


def shim_vendor(pe):
    """(vendor certificates DER, vendor dbx (certs, hashes, tbs-hashes))
    from shim's .vendor_cert: four u32s -- authorized size, deauthorized
    size, authorized offset, deauthorized offset -- relative to the
    section. Ubuntu builds the authorized half as one DER certificate
    (Canonical's master CA); a build from a signature list is read as
    one."""
    s = pe.sections.get(".vendor_cert")
    if not s or len(s) < 16:
        return [], ([], set(), set())
    asz, dsz, aoff, doff = struct.unpack_from("<IIII", s, 0)
    a = s[aoff:aoff + asz]
    certs = [a] if a[:1] == b"\x30" else sig_lists(a)[0]
    return certs, sig_lists(s[doff:doff + dsz])[:3]


def revoked_by(binary, level):
    """The (component, has, needs) a level revokes in BINARY, if any."""
    out = []
    for name, gen in binary.items():
        if name in level and gen < level[name]:
            out.append((name, gen, level[name]))
    return out


# ═══════════════════════════════════════════════════════════════════
#  Authenticode, the way firmware checks it
# ═══════════════════════════════════════════════════════════════════
def der(b, o):
    """(tag, header length, content length) of the DER element at O."""
    tag = b[o]
    ln = b[o + 1]
    if ln < 0x80:
        return tag, 2, ln
    n = ln & 0x7F
    if n == 0 or n > 4:
        raise ValueError("bad DER length")
    return tag, 2 + n, int.from_bytes(b[o + 2:o + 2 + n], "big")


def children(b, o):
    """The elements inside the constructed element at O."""
    tag, h, n = der(b, o)
    i, end, out = o + h, o + h + n, []
    if end > len(b):
        raise ValueError("DER element runs past its end")
    while i < end:
        t, hh, nn = der(b, i)
        out.append(i)
        i += hh + nn
    return out


def whole(b, o):
    t, h, n = der(b, o)
    return b[o:o + h + n]


def inner(b, o):
    t, h, n = der(b, o)
    return b[o + h:o + h + n]


OID_SHA256 = bytes.fromhex("608648016503040201")
OID_MSGDIGEST = bytes.fromhex("2a864886f70d010904")
OID_RSA = bytes.fromhex("2a864886f70d010101")
OID_RSA_SHA256 = bytes.fromhex("2a864886f70d01010b")

# Every check below keeps to public APIs that python3-cryptography 41
# (Ubuntu 24.04's) also has.
from cryptography import x509                                 # noqa: E402
from cryptography.hazmat.primitives import hashes              # noqa: E402
from cryptography.hazmat.primitives.asymmetric import padding, rsa  # noqa: E402
from cryptography.hazmat.primitives.serialization import Encoding  # noqa: E402
_DER = Encoding.DER


def load_cert(d):
    """One certificate from D, ignoring bytes after it: signature-list
    entries are padded, and firmware's d2i_X509 reads the first element
    and stops. Refusing them would drop a db entry (a false refusal) or
    a dbx one (a revocation ignored)."""
    try:
        t, h, n = der(d, 0)
        return x509.load_der_x509_certificate(d[:h + n])
    except Exception:
        return None


# The extensions OpenSSL understands. A CRITICAL extension outside these
# makes OpenSSL -- and so EDK2 and shim -- refuse the chain.
KNOWN_EXT = {x509.BasicConstraints, x509.KeyUsage, x509.ExtendedKeyUsage,
             x509.SubjectAlternativeName, x509.IssuerAlternativeName,
             x509.CertificatePolicies, x509.NameConstraints,
             x509.PolicyConstraints, x509.InhibitAnyPolicy,
             x509.SubjectKeyIdentifier, x509.AuthorityKeyIdentifier,
             x509.CRLDistributionPoints, x509.AuthorityInformationAccess}


def critical_ok(c):
    try:
        for e in c.extensions:
            if e.critical and type(e.value) not in KNOWN_EXT:
                return False
    except Exception:
        return False
    return True


def can_issue(c):
    """May C sign certificates? CA:TRUE, and keyCertSign if it limits
    its key usage at all. A v1 certificate (no extensions) counts if it
    is self-signed, as OpenSSL counts it."""
    try:
        bc = c.extensions.get_extension_for_class(x509.BasicConstraints).value
        if not bc.ca:
            return False
    except x509.ExtensionNotFound:
        return c.version == x509.Version.v1 and c.issuer == c.subject
    try:
        ku = c.extensions.get_extension_for_class(x509.KeyUsage).value
        if not ku.key_cert_sign:
            return False
    except x509.ExtensionNotFound:
        pass
    return True


def issued(child, parent):
    """Did PARENT sign CHILD, and is PARENT allowed to?"""
    if child.issuer != parent.subject or not can_issue(parent) or not critical_ok(parent):
        return False
    try:
        child.verify_directly_issued_by(parent)
        return True
    except Exception:
        return False


def path_to(signer, bag, anchors, anchor_hashes=()):
    """Walk from SIGNER up through BAG (the certificates the signature
    carries, which are never trusted for themselves) until a
    certificate in ANCHORS is reached -- by being one of them, or by
    being signed by one. That is UEFI's rule: a db entry is a trust
    anchor even when it is an intermediate. ANCHOR_HASHES are dbx's
    EFI_CERT_X509_SHA256 entries: SHA-256 of a certificate's TBS."""
    if not critical_ok(signer):
        return None
    cur, seen = signer, set()
    for _ in range(8):
        dc = cur.public_bytes(_DER)
        if dc in seen:
            return None
        seen.add(dc)
        if hashlib.sha256(cur.tbs_certificate_bytes).digest() in anchor_hashes:
            return cur
        for a in anchors:
            if a.public_bytes(_DER) == dc or issued(cur, a):
                return a
        up = [c for c in bag if c.public_bytes(_DER) != dc and issued(cur, c)]
        if not up:
            return None
        cur = up[0]
    return None


class Signature:
    """One PKCS#7 SignedData from a WIN_CERTIFICATE, checked for what it
    signs (the image's Authenticode digest) and whether the signature
    over it holds. Its signer is then judged against anchors."""

    def __init__(self, p7, image_digest):
        self.signer, self.bag, self.why = None, [], None
        try:
            self._check(p7, image_digest)
        except Exception as e:
            self.signer = None
            self.why = "unreadable signature (%s)" % (e.__class__.__name__,)

    def _check(self, p7, image_digest):
        ci = children(p7, 0)                       # ContentInfo
        sd = children(p7, ci[1])[0]                # [0] -> SignedData
        parts = children(p7, sd)
        eci = parts[2]                             # encapContentInfo
        spc = children(p7, children(p7, eci)[1])[0]  # [0] -> SpcIndirectData
        k = 3
        if p7[parts[k]] == 0xA0:                   # certificates
            self.bag = [c for c in (load_cert(whole(p7, x)) for x in children(p7, parts[k])) if c]
            k += 1
        if p7[parts[k]] == 0xA1:                   # crls
            k += 1
        sis = children(p7, parts[k])
        # ONE SignerInfo. OpenSSL's PKCS7_verify, which EDK2 and shim
        # call, fails if ANY of them fails; Authenticode has exactly one.
        if len(sis) != 1:
            self.why = "%d signer infos, not one" % len(sis)
            return
        si = children(p7, sis[0])

        # what is signed: SpcIndirectDataContent's DigestInfo
        di = children(p7, spc)[1]
        alg, dig = children(p7, di)
        if inner(p7, children(p7, alg)[0]) != OID_SHA256:
            self.why = "not a SHA-256 Authenticode signature"
            return
        if inner(p7, dig) != image_digest:
            self.why = "the file is not the file that was signed"
            return

        # which certificate signed it
        iname, serial = children(p7, si[1])
        want_issuer = whole(p7, iname)
        want_serial = int.from_bytes(inner(p7, serial), "big", signed=True)
        for c in self.bag:
            if c.serial_number == want_serial and \
               c.issuer.public_bytes() == want_issuer:
                self.signer = c
                break
        if not self.signer:
            self.why = "its signer's certificate is not in it"
            return

        # how it says it signed: SHA-256 with RSA, nothing else
        if inner(p7, children(p7, si[2])[0]) != OID_SHA256:
            self.signer, self.why = None, "its signer did not use SHA-256"
            return
        if p7[si[3]] != 0xA0:
            self.signer, self.why = None, "no signed attributes"
            return
        if inner(p7, children(p7, si[4])[0]) not in (OID_RSA, OID_RSA_SHA256):
            self.signer, self.why = None, "not an RSA signature"
            return

        # the signed attributes: messageDigest must be the hash of the
        # SpcIndirectData content (PKCS#7: its contents, without the
        # outer tag and length), and the signature is over them as a SET
        attrs = si[3]
        md = None
        for a in children(p7, attrs):
            oid, vals = children(p7, a)
            if inner(p7, oid) == OID_MSGDIGEST:
                md = inner(p7, children(p7, vals)[0])
        if md != hashlib.sha256(inner(p7, spc)).digest():
            self.signer, self.why = None, "its signed attributes do not match what it signs"
            return
        signed = b"\x31" + whole(p7, attrs)[1:]
        sig = inner(p7, si[5])
        key = self.signer.public_key()
        try:
            if not isinstance(key, rsa.RSAPublicKey):
                raise ValueError("key type")
            key.verify(sig, signed, padding.PKCS1v15(), hashes.SHA256())
        except Exception:
            self.why = "the signature does not verify"
            self.signer = None


def judge_image(data, anchors, deny_certs, deny_hashes, deny_tbs, allow_hashes=()):
    """None if a verifier holding ANCHORS (db, or a shim's vendor
    certificate) and the DENY lists (dbx, vendor dbx) would start DATA;
    else why not. Anything this cannot read is a refusal, never a
    crash: a traceback here used to leave no record and no sync."""
    try:
        pe = PE(data)
        digest = pe.authenticode_sha256()
        if digest != pe.edk2_sha256():
            return "its layout makes the firmware's hash differ from the signed one"
        if digest in deny_hashes:
            return "its hash is revoked"
        blobs = pe.signatures()
        if blobs is None:
            return "its certificate table is malformed"
        if digest in allow_hashes:
            return None                   # db may list an image by hash
        sigs = [Signature(p, digest) for p in blobs]
        if not sigs:
            return "it is not signed"
        good = []
        for s in sigs:
            if s.signer is None:
                continue
            # ANY valid signature that chains to a revoked certificate
            # refuses the whole image, even if another one is trusted
            # (EDK2; shim is laxer, so this is the stricter of the two).
            if path_to(s.signer, s.bag, deny_certs, deny_tbs) is not None:
                return "one of its signatures is from a revoked certificate (%s)" % \
                    s.signer.subject.rfc4514_string()
            good.append(s)
        for s in good:
            if path_to(s.signer, s.bag, anchors):
                return None
        why = [s.why for s in sigs if s.why]
        return "no signature chains to a trusted certificate" + \
            (" (%s)" % "; ".join(why) if why else "")
    except Exception as e:
        return "unreadable (%s)" % e.__class__.__name__


