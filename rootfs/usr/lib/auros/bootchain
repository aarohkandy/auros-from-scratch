def die(msg, code=1):
    print("bootchain: " + msg, file=sys.stderr)
    sys.exit(code)


def write_atomic(path, data, mode=0o644):
    """PATH holds the old bytes or the new ones, never half of either.

    On vfat a rename reuses the target's directory slot and frees the
    old file's clusters, and fsync of the directory does not write the
    renamed file's entry -- so the new file, the directory and then the
    whole filesystem are synced before and after the rename."""
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".bootchain.", dir=d)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        try:
            os.chmod(tmp, mode)
        except OSError:
            pass                    # vfat: no modes, and that is fine
        os.sync()
        os.rename(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    for p in (path, d):
        try:
            fd = os.open(p, os.O_RDONLY)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
        except OSError:
            pass
    os.sync()


