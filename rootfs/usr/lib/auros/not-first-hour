#!/bin/sh
# ExecCondition for apt-daily.service and apt-daily-upgrade.service.
#
# Exit 0: go ahead. Exit 1: not now (systemd skips the run; the timer
# comes round again tomorrow).
#
# The first hour of this computer's life is the hour she spends
# installing the programs she came for. Ubuntu's daily update, if its
# timer lands in that hour, takes the package lock for minutes, and the
# store says "Waiting for package manager lock" -- or simply sits there
# -- right when she pressed Install. Security updates a few hours later
# cost her nothing; a store that hangs on her first try costs the
# machine.
#
# "First hour" is measured two ways, because the clock on a PC that
# came from Windows is often hours off until the network corrects it:
# from when first boot finished, and, on the boot where it finished,
# from when the machine was switched on.
f=${AUROS_FIRSTBOOT_STAMP:-/var/lib/auros/firstboot.done}
# No record of first boot at all is a machine where something else is
# wrong, and blocking its security updates for ever would make that
# worse. Only a record that says "just now" holds them back.
[ -e "$f" ] || exit 0
now=$(date +%s)
done_at=$(stat -c %Y "$f" 2>/dev/null || echo 0)
up=$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 999999)
booted=$((now - up))
if [ "$done_at" -ge $((booted - 60)) ] && [ "$up" -lt 3600 ]; then
    exit 1                       # this is the boot it finished on
fi
if [ $((now - done_at)) -lt 3600 ] && [ $((now - done_at)) -ge -86400 ]; then
    exit 1
fi
exit 0
